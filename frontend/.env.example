# Where the Django API runs. On Vercel, the backend project's URL, e.g. https://portfolio-api.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# The official address, for canonical URLs, the sitemap and link previews
NEXT_PUBLIC_SITE_URL=https://josafath-dev.vercel.app

# Optional: the code from Google Search Console (HTML tag method), without the <meta> tag around it
GOOGLE_SITE_VERIFICATION=
