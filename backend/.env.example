# Copy to .env for local development: cp .env.example .env
# Load it into your shell with: set -a && . ./.env && set +a

# 1 only on your machine. Never set it on Vercel.
DJANGO_DEBUG=1

# Required when DJANGO_DEBUG is not 1. Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Leave empty to use SQLite (db.sqlite3). On Vercel, the Neon Postgres URL.
DATABASE_URL=

# Comma-separated. Vercel's own *.vercel.app hosts are added automatically.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Where the frontend runs, so its browser requests (the contact form) are allowed.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CORS_ALLOWED_ORIGIN_REGEXES=
